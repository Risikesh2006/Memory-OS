# --- Database (Supabase Postgres) -----------------------------------------------------------
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the "connection pooling" string in production; direct connection is fine for local dev.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/postgres
# Set to "false" only for a local, non-TLS Postgres (e.g. self-hosted `supabase start`).
DATABASE_SSL=true

# --- Supabase Auth / API ----------------------------------------------------------------------
# Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. NEVER expose this to the frontend/mobile app -- it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret. Used to verify Supabase
# session tokens locally without a network round trip on every request.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# For phone OTP to actually send SMS, configure a Phone provider (Twilio, MessageBird, Vonage)
# under Supabase Dashboard -> Authentication -> Providers -> Phone. There is no env var for this
# here -- it's configured entirely in the Supabase project itself.

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
API_PORT=5000

# --- Media storage -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- AI provider ---------------------------------------------------------------------------
# Leave AI_PROVIDER unset (or "local") to use the built-in non-LLM fallback (extractive
# summaries/tags, rule-based grounded chat) -- this works with zero configuration.
# Set AI_PROVIDER=openai and provide OPENAI_API_KEY to use real generative AI for chat/search
# phrasing and embeddings; no code changes are needed to switch.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Push notifications (mobile companion app) ------------------------------------------------
# Required only once the mobile app is built; backend endpoints (devices, push tokens) work
# without these, they just can't actually deliver a push until configured.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
